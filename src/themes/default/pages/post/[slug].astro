---
import BaseLayout from '../../layouts/BaseLayout.astro';
import dataService from '@lib/notion/service';
import { formatDate } from '@lib/utils/date';
import { isValidSlug } from '@lib/utils/slug';
import { getResolvedSiteConfig } from '@config/resolved-site';
import { themeOptions } from '@lib/theme/options';
import Comments from '../../components/Comments.astro';
import '../../styles/notion.css';

export async function getStaticPaths() {
  console.log('[getStaticPaths] Function called');

  const posts = await dataService.getAllPosts();

  console.log(`[getStaticPaths] Total posts: ${posts.length}`);

  // 检查并过滤无效的 slug
  const invalidPosts = posts.filter(post => !isValidSlug(post.slug));
  if (invalidPosts.length > 0) {
    console.error(`[getStaticPaths] Found ${invalidPosts.length} posts with invalid slug:`,
      invalidPosts.map(p => ({ id: p.id, title: p.title, slug: p.slug }))
    );
  }

  const paths = posts
    .filter(post => isValidSlug(post.slug))
    .map((post, index, filteredPosts) => {
      // 计算上一篇和下一篇（文章按日期降序，索引 0 是最新）
      const prevPost = index < filteredPosts.length - 1 ? filteredPosts[index + 1] : null;
      const nextPost = index > 0 ? filteredPosts[index - 1] : null;

      return {
        params: { slug: post.slug },
        props: { post, prevPost, nextPost },
      };
    });

  console.log(`[getStaticPaths] Generated ${paths.length} valid paths (filtered out ${posts.length - paths.length} invalid)`);

  return paths;
}

const { post, prevPost, nextPost } = Astro.props;

// 获取解析后的站点配置
const SITE_CONFIG = await getResolvedSiteConfig();

// 主题选项（声明见 theme.config.mjs，宿主可经 NOPRESS_THEME_OPTIONS 覆盖）
const { showPostCover = true, showReadingTime = true } = themeOptions as {
  showPostCover?: boolean;
  showReadingTime?: boolean;
};

// Markdown 版本信息（对 AI Agent 可见的发现提示）
const markdownUrl = `/post/${post.slug}.md`;
const markdownAbsUrl = Astro.site ? new URL(markdownUrl, Astro.site).href : markdownUrl;

---

<BaseLayout title={post.title} description={post.description} image={post.coverUrl} markdownUrl={markdownUrl}>
  <article class="content">
    <!-- Notion 风格页面 -->
    <div class="notion-page">
      <!-- 封面图 - Notion 风格全宽封面（showPostCover 选项，OG 图不受影响） -->
      {showPostCover && post.coverUrl && (
        <div class="page-cover">
          <img src={post.coverUrl} alt={post.title} loading="eager" fetchpriority="high" />
        </div>
      )}

      <div class="page-container">
        <!-- 主内容区 -->
        <div class="page-main">
          <!-- 页面标题 - Notion 风格大标题 -->
          <header class="page-header">
            <h1 class="page-title">
              {post.icon && (
                post.icon.startsWith('http')
                  ? <img src={post.icon} alt="" class="page-icon" />
                  : <span class="page-icon-emoji">{post.icon}</span>
              )}
              {post.title}
            </h1>
          </header>

          <!-- 页面元信息 - 内联式显示 -->
          <div class="page-meta">
            <div class="meta-info">
              <span class="meta-item">
                <span class="meta-icon">📅</span>
                <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
              </span>
              {showReadingTime && post.readingTime && (
                <span class="meta-item">
                  <span class="meta-icon">⏱️</span>
                  <span>{post.readingTime} 分钟阅读</span>
                </span>
              )}
            </div>

            {/* 标签 */}
            {post.tags.length > 0 && (
              <div class="meta-tags">
                <span class="tags-icon">🏷️</span>
                {post.tags.map(tag => (
                  <a href={`/tag/${tag.toLowerCase()}`} class="tag-pill">{tag}</a>
                ))}
              </div>
            )}

            {/* 摘要 */}
            {post.description && (
              <div class="meta-description">
                {post.description}
              </div>
            )}
          </div>

          <!-- 分隔线 -->
          <hr class="page-divider" />

          <!-- 页面内容 -->
          {/* Markdown 版本提示：Agent 读源码可发现，浏览器不渲染 */}
          <Fragment set:html={`<!-- This page is also available as Markdown: ${markdownAbsUrl} -->`} />
          <div class="notion-content" set:html={post.content} />

          <!-- 上一篇/下一篇导航 -->
          <nav class="post-navigation">
            {prevPost && (
              <a href={`/post/${prevPost.slug}`} class="nav-link nav-prev">
                <span class="nav-label">← 上一篇</span>
                <span class="nav-title">{prevPost.title}</span>
              </a>
            )}

            {nextPost && (
              <a href={`/post/${nextPost.slug}`} class="nav-link nav-next">
                <span class="nav-label">下一篇 →</span>
                <span class="nav-title">{nextPost.title}</span>
              </a>
            )}
          </nav>

          <!-- 页面底部 -->
          <footer class="page-footer">
            <a href="/" class="back-link">← 返回首页</a>
          </footer>

          <!-- 评论系统 -->
          {SITE_CONFIG.comments.enabled && (
            <section class="comments-section">
              <Comments slug={post.slug} title={post.title} />
            </section>
          )}
        </div>

        <!-- 目录侧边栏 -->
        <aside class="toc-container">
          <div class="toc-wrapper">
            <div class="toc-title">目录</div>
            <nav class="toc-nav">
              <!-- 目录内容由 JavaScript 生成 -->
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { initTableOfContents } from '@/scripts/table-of-contents';
  initTableOfContents();
</script>

<style>
  /* Notion 页面容器 */
  .notion-page {
    max-width: 100%;
  }

  /* 页面容器 - 相对定位，用于定位目录 */
  .page-container {
    position: relative;
    max-width: 900px; /* 正文最大宽度 */
    margin: 0 auto;
  }

  .page-main {
    width: 100%;
  }

  /* 封面图 - Notion 风格全宽封面 */
  .page-cover {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: -45px; /* 向上移动抵消 main 的 padding-top，让封面图从顶部开始 */
    height: 30vh;
    min-height: 280px;
    max-height: 400px;
    overflow: hidden;
  }

  .page-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  /* 页面标题 - Notion 风格 */
  .page-header {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-lg);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--notion-text-primary);
    word-wrap: break-word;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  /* 页面图标 */
  .page-icon {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .page-icon-emoji {
    font-size: 3rem;
    line-height: 1;
    flex-shrink: 0;
  }

  /* 页面元信息 - 内联式显示 */
  .page-meta {
    margin-bottom: var(--spacing-xl);
  }

  /* 元信息行：日期和阅读时间 */
  .meta-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-md);
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .meta-icon {
    font-size: 0.875rem;
    line-height: 1;
    width: 1.2em; /* 固定宽度确保对齐 */
    text-align: center;
  }

  /* 标签行 */
  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
    padding-left: 0; /* 对齐元信息的图标位置 */
  }

  .tags-icon {
    font-size: 0.875rem;
    line-height: 1;
    width: 1.2em; /* 和 meta-icon 保持一致 */
    text-align: center;
    margin-right: var(--spacing-xs);
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text-secondary);
    border-radius: 3px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--transition-fast);
    border: none;
  }

  .tag-pill:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
    border: none;
  }

  /* 摘要 - 引用块样式 */
  .meta-description {
    font-size: 0.937rem;
    line-height: 1.6;
    color: var(--notion-text-secondary);
    font-style: italic;
    padding: var(--spacing-sm) var(--spacing-md);
    border-left: 3px solid var(--notion-border);
    background-color: transparent;
  }

  /* 分隔线 */
  .page-divider {
    margin: var(--spacing-xl) 0;
    border: none;
    border-top: 1px solid var(--notion-border);
  }

  /* Notion 内容 */
  .notion-content {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--notion-text-primary);
    margin-bottom: var(--spacing-3xl);
  }

  /* 评论区 */
  .comments-section {
    margin-top: var(--spacing-2xl);
  }

  /* ========== 上一篇/下一篇导航 ========== */
  .post-navigation {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin: var(--spacing-3xl) 0;
  }

  .nav-link {
    flex: 1;
    max-width: 50%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
    background-color: var(--notion-bg-secondary);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color var(--transition-fast);
    border: none;
  }

  .nav-link:hover {
    background-color: var(--notion-bg-hover);
    border: none;
  }

  .nav-prev {
    text-align: left;
    margin-right: auto;
  }

  .nav-next {
    text-align: right;
    margin-left: auto;
  }

  .nav-label {
    font-size: 0.75rem;
    color: var(--notion-text-tertiary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-size: 0.937rem;
    color: var(--notion-text-primary);
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nav-link:hover .nav-title {
    color: var(--notion-link);
  }

  /* 页面底部 */
  .page-footer {
    padding-top: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    text-decoration: none;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    border: none;
  }

  .back-link:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
    border: none;
  }

  /* ========== 目录样式 ========== */

  /* 触发区（hitbox）：几何恒定，仅负责 hover 触发与 fixed 定位。
     自身永远不承担视觉样式，避免 hover 引发尺寸变化导致的状态翻转抖动 */
  .toc-container {
    position: fixed;
    right: max(32px, calc((100vw - 900px) / 2 - 240px - 48px));
    top: 100px; /* 初始值，会被 JavaScript 动态调整 */
    width: 240px;
    z-index: 10;
  }

  /* 面板（panel）：承载视觉与滚动 */
  .toc-wrapper {
    width: 100%;
    max-height: calc(100vh - 120px); /* 初始值，会被 JavaScript 动态调整 */
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(55, 53, 47, 0.16) transparent;
  }

  .toc-wrapper::-webkit-scrollbar {
    width: 3px;
  }

  .toc-wrapper::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-wrapper::-webkit-scrollbar-thumb {
    background: rgba(55, 53, 47, 0.16);
    border-radius: 2px;
  }

  .toc-wrapper::-webkit-scrollbar-thumb:hover {
    background: rgba(55, 53, 47, 0.24);
  }

  :root.dark .toc-wrapper {
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }

  :root.dark .toc-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
  }

  :root.dark .toc-wrapper::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(55, 53, 47, 0.65);
    margin-bottom: var(--spacing-md);
    padding-left: 0;
  }

  :root.dark .toc-title {
    color: rgba(255, 255, 255, 0.45);
  }

  .toc-nav {
    font-size: 0.875rem;
  }

  /* 动态生成的目录列表需要全局样式 */
  :global(.toc-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: 0;
  }

  :global(.toc-item) {
    margin: 2px 0;
    padding: 0;
    line-height: 1.5;
    /* 层级缩进由 --toc-indent 变量控制（窄屏横条态会重置为 0） */
    margin-left: var(--toc-indent, 0);
  }

  :global(.toc-link) {
    color: rgba(55, 53, 47, 0.65);
    text-decoration: none;
    transition: color 0.12s ease;
    font-size: 0.875rem;
    line-height: 1.5;
    border-bottom: none !important;
    display: block;
  }

  :root.dark :global(.toc-link) {
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.toc-link:hover) {
    color: rgba(55, 53, 47, 0.85);
    border-bottom: none !important;
  }

  :root.dark :global(.toc-link:hover) {
    color: rgba(255, 255, 255, 0.65);
  }

  :global(.toc-link.toc-active) {
    color: rgb(35, 131, 226);
  }

  :root.dark :global(.toc-link.toc-active) {
    color: rgb(82, 156, 202);
  }

  /* 空目录时隐藏 */
  .toc-empty {
    display: none;
  }

  /* 悬浮标题提示（JS 运行时创建，需全局样式；仅窄屏横条模式显示） */
  :global(.toc-tooltip) {
    display: none;
  }

  /* ===== 窄屏横条模式（Codex 风格）===== */
  @media (min-width: 769px) and (max-width: 1440px) {
    /* hitbox：固定小尺寸且永不变化，hover 状态因此绝对稳定 */
    .toc-container {
      right: 16px;
      width: 64px;
    }

    .toc-wrapper {
      width: 100%;
      padding: 0;
    }

    .toc-title {
      display: none;
    }

    /* 紧凑横条行距 */
    :global(.toc-item) {
      margin: 1px 0;
      margin-left: 0;
      padding: 0;
      line-height: 1;
    }

    /* 链接占满整行高度（12px）保证易悬停，横条由 ::before 绘制 */
    :global(.toc-link) {
      display: flex;
      align-items: center;
      width: 100%;
      height: 12px;
      color: transparent;
      font-size: 0;
      white-space: nowrap;
    }

    /* 横条本体：宽度按标题长度映射（--bar-width 由 JS 计算） */
    :global(.toc-link)::before {
      content: '';
      display: block;
      width: var(--bar-width, 32px);
      height: 3px;
      border-radius: 2px;
      background: rgba(55, 53, 47, 0.15);
      transition:
        width 0.18s cubic-bezier(0.4, 0, 0.2, 1),
        background-color 0.18s ease;
    }

    :root.dark :global(.toc-link)::before {
      background: rgba(255, 255, 255, 0.15);
    }

    /* hover：该横条加深并延伸，其余横条保持不动 */
    :global(.toc-link:hover)::before {
      width: calc(var(--bar-width, 32px) + 10px);
      background: rgba(55, 53, 47, 0.35);
    }

    :root.dark :global(.toc-link:hover)::before {
      background: rgba(255, 255, 255, 0.35);
    }

    :global(.toc-link.toc-active)::before {
      background: rgba(55, 53, 47, 0.5);
    }

    :root.dark :global(.toc-link.toc-active)::before {
      background: rgba(255, 255, 255, 0.5);
    }

    /* 悬浮显示 hover 条目对应的完整标题 */
    :global(.toc-tooltip) {
      display: block;
      position: absolute;
      right: calc(100% + 10px);
      top: 0;
      transform: translateY(-50%);
      max-width: 280px;
      padding: 5px 10px;
      background: var(--notion-bg-primary);
      border: 1px solid var(--notion-border);
      border-radius: 6px;
      box-shadow: rgba(15, 15, 15, 0.05) 0px 2px 8px,
                  rgba(15, 15, 15, 0.06) 0px 8px 24px;
      font-size: 0.8125rem;
      line-height: 1.4;
      color: rgba(55, 53, 47, 0.85);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
      z-index: 20;
    }

    :root.dark :global(.toc-tooltip) {
      color: rgba(255, 255, 255, 0.75);
      box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px,
                  rgba(0, 0, 0, 0.3) 0px 8px 24px;
    }

    :global(.toc-tooltip.toc-tooltip-visible) {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .toc-container {
      display: none;
    }

    .page-cover {
      height: 25vh;
      min-height: 200px;
      max-height: 300px;
    }

    .page-title {
      font-size: 2rem;
    }

    /* 移动端导航样式 */
    .post-navigation {
      flex-direction: column;
    }

    .nav-link {
      max-width: 100%;
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .nav-prev {
      margin-right: 0;
    }

    .nav-next {
      margin-left: 0;
    }

    .nav-prev,
    .nav-next {
      text-align: left;
    }

    /* 移动端元信息自动换行 */
    .meta-info {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }

    .meta-item:not(:last-child)::after {
      margin-left: var(--spacing-sm);
    }

    .meta-description {
      font-size: 0.875rem;
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .page-title {
      font-size: 1.75rem;
    }
  }
</style>
