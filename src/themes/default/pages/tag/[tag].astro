---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import dataService from '@lib/data';
import { formatDate } from '@lib/utils/date';

export async function getStaticPaths() {
  const allPosts = await dataService.getAllPosts();

  // 收集所有标签
  const tagsSet = new Set<string>();
  allPosts.forEach(post => {
    post.tags.forEach(tag => tagsSet.add(tag.toLowerCase()));
  });

  // 为每个标签生成路径
  const paths = Array.from(tagsSet).map(tag => {
    const postsWithTag = allPosts.filter(post =>
      post.tags.some(t => t.toLowerCase() === tag)
    );

    return {
      params: { tag },
      props: {
        tag,
        posts: postsWithTag,
        // 原始标签名（用于显示，保留大小写）
        displayTag: postsWithTag[0]?.tags.find(t => t.toLowerCase() === tag) || tag
      },
    };
  });

  console.log(`[getStaticPaths] Generated ${paths.length} tag paths`);

  return paths;
}

const { tag, posts, displayTag } = Astro.props;
---

<BaseLayout
  title={`标签: ${displayTag}`}
  description={`浏览标签"${displayTag}"下的所有文章`}
>
  <div class="content">
    <!-- 页面头部 - Notion 风格 -->
    <header class="page-header">
      <h1 class="page-title">
        <span class="tag-icon">🏷️</span>
        {displayTag}
      </h1>
      <p class="page-stats">共 {posts.length} 篇文章</p>
    </header>

    <!-- 文章列表 - Notion 数据库视图 -->
    <div class="notion-database">
      {posts.map(post => (
        <article class="database-row">
          <a href={`/post/${post.slug}`} class="row-link">
            <div class="row-content">
              <!-- 标题和日期 -->
              <div class="row-main">
                <div class="row-title">
                  <span class="title-icon">📄</span>
                  <h2 class="title-text">{post.title}</h2>
                </div>
                <time class="row-date" datetime={post.publishedAt}>
                  {formatDate(post.publishedAt)}
                </time>
              </div>

              <!-- 标签 -->
              {post.tags.length > 0 && (
                <div class="row-tags">
                  {post.tags.map(t => (
                    <span
                      class={`tag-pill ${t.toLowerCase() === tag ? 'active' : ''}`}
                    >
                      {t}
                    </span>
                  ))}
                </div>
              )}

              <!-- 摘要 -->
              {post.description && (
                <p class="row-description">{post.description}</p>
              )}

              <!-- 阅读时间 -->
              {post.readingTime && (
                <div class="row-meta">
                  <span class="meta-item">⏱️ {post.readingTime} 分钟阅读</span>
                </div>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- 返回链接 -->
    <footer class="page-footer">
      <a href="/archive" class="back-link">← 返回归档</a>
    </footer>
  </div>
</BaseLayout>

<style>
  /* 页面头部 - Notion 风格 */
  .page-header {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-sm);
    color: var(--notion-text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .tag-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .page-stats {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin: 0;
  }

  /* Notion 数据库视图 */
  .notion-database {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--spacing-2xl);
  }

  .database-row {
    background-color: var(--notion-bg-primary);
    transition: background-color var(--transition-fast);
    border-radius: var(--radius-sm);
  }

  .database-row:hover {
    background-color: var(--notion-bg-hover);
  }

  .row-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    text-decoration: none;
    color: inherit;
    border: none;
  }

  .row-link:hover {
    border: none;
  }

  .row-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  /* 主要内容行 */
  .row-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .row-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex: 1;
    min-width: 0;
  }

  .title-icon {
    font-size: 1.125rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .title-text {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    color: var(--notion-text-primary);
    transition: color var(--transition-fast);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-link:hover .title-text {
    color: var(--notion-link);
  }

  .row-date {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--notion-text-tertiary);
  }

  /* 标签行 */
  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text-secondary);
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: background-color var(--transition-fast);
  }

  .tag-pill.active {
    background-color: var(--notion-link);
    color: white;
  }

  .database-row:hover .tag-pill:not(.active) {
    background-color: var(--notion-bg-hover);
  }

  /* 描述文本 */
  .row-description {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--notion-text-secondary);
    margin: 0;
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 元数据行 */
  .row-meta {
    display: flex;
    gap: var(--spacing-md);
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
  }

  .meta-item {
    font-size: 0.75rem;
    color: var(--notion-text-tertiary);
  }

  /* 页面底部 */
  .page-footer {
    padding-top: var(--spacing-lg);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    text-decoration: none;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    border: none;
  }

  .back-link:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
    border: none;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .tag-icon {
      font-size: 1.75rem;
    }

    .row-main {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
    }

    .row-title {
      width: 100%;
    }

    .row-date {
      font-size: 0.75rem;
    }

    .row-tags,
    .row-description,
    .row-meta {
      margin-left: 0;
    }

    .title-icon {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .page-title {
      font-size: 1.75rem;
    }

    .row-link {
      padding: var(--spacing-sm) var(--spacing-xs);
    }
  }
</style>
