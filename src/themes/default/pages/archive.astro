---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import dataService from '@lib/data';
import { formatDate } from '@lib/utils/date';

// 获取所有文章
const allPosts = await dataService.getAllPosts();

// 按标签分组文章
const postsByTag: Record<string, typeof allPosts> = {};
allPosts.forEach(post => {
  post.tags.forEach(tag => {
    if (!postsByTag[tag]) {
      postsByTag[tag] = [];
    }
    postsByTag[tag].push(post);
  });
});

// 获取所有标签（按文章数量排序）
const sortedTags = Object.entries(postsByTag)
  .map(([tag, posts]) => ({ tag, count: posts.length }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="归档" description="浏览所有标签和文章">
  <div class="content">
    <!-- 页面头部 - Notion 风格 -->
    <header class="page-header">
      <h1 class="page-title">归档</h1>
      <p class="page-stats">
        共 {allPosts.length} 篇文章 · {sortedTags.length} 个标签
      </p>
    </header>

    <!-- 标签云 - Notion 风格标签列表 -->
    <section class="tags-section">
      <h2 class="section-title">📑 所有标签</h2>
      <div class="tags-list">
        {sortedTags.map(({ tag, count }) => (
          <a href={`/tag/${tag.toLowerCase()}`} class="tag-item">
            <span class="tag-name">{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 所有文章 - Notion 数据库视图 -->
    <section class="posts-section">
      <h2 class="section-title">📚 所有文章</h2>
      <div class="post-list">
        {allPosts.map(post => (
          <article class="post-card">
            <a href={`/post/${post.slug}`} class="row-link">
              <div class="row-content">
                <!-- 标题和日期 -->
                <div class="row-main">
                  <div class="row-title">
                    <span class="title-icon">📄</span>
                    <h3 class="title-text">{post.title}</h3>
                  </div>
                  <time class="row-date" datetime={post.publishedAt}>
                    {formatDate(post.publishedAt)}
                  </time>
                </div>

                <!-- 标签 -->
                {post.tags.length > 0 && (
                  <div class="row-tags">
                    {post.tags.map(tag => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>
                )}

                <!-- 摘要 -->
                {post.description && (
                  <p class="row-description">{post.description}</p>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* 页面头部 - Notion 风格 */
  .page-header {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-sm);
    color: var(--notion-text-primary);
  }

  .page-stats {
    font-size: 0.875rem;
    color: var(--notion-text-secondary);
    margin: 0;
  }

  /* 标签区域 */
  .tags-section,
  .posts-section {
    margin-bottom: var(--spacing-3xl);
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    color: var(--notion-text-primary);
  }

  /* 标签列表 - Notion pill 风格 */
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 4px 10px;
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text-primary);
    border-radius: 3px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--transition-fast);
    border: none;
  }

  .tag-item:hover {
    background-color: var(--notion-bg-hover);
    border: none;
  }

  .tag-name {
    line-height: 1;
  }

  .tag-count {
    font-size: 0.75rem;
    opacity: 0.6;
    background-color: rgba(0, 0, 0, 0.06);
    padding: 2px 6px;
    border-radius: 2px;
    line-height: 1;
  }

  :global(.dark) .tag-count {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* 文章列表 */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-card {
    background-color: var(--notion-bg-primary);
    transition: background-color var(--transition-fast);
    border-radius: var(--radius-sm);
  }

  .post-card:hover {
    background-color: var(--notion-bg-hover);
  }

  .row-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    text-decoration: none;
    color: inherit;
    border: none;
  }

  .row-link:hover {
    border: none;
  }

  .row-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  /* 主要内容行 */
  .row-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .row-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex: 1;
    min-width: 0;
  }

  .title-icon {
    font-size: 1.125rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .title-text {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    color: var(--notion-text-primary);
    transition: color var(--transition-fast);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-link:hover .title-text {
    color: var(--notion-link);
  }

  .row-date {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--notion-text-tertiary);
  }

  /* 标签行 */
  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text-secondary);
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: background-color var(--transition-fast);
  }

  .post-card:hover .tag-pill {
    background-color: var(--notion-bg-hover);
  }

  /* 描述文本 */
  .row-description {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--notion-text-secondary);
    margin: 0;
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .row-main {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
    }

    .row-title {
      width: 100%;
    }

    .row-date {
      font-size: 0.75rem;
    }

    .row-tags,
    .row-description {
      margin-left: 0;
    }

    .title-icon {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .page-title {
      font-size: 1.75rem;
    }

    .row-link {
      padding: var(--spacing-sm) var(--spacing-xs);
    }
  }
</style>
