---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResolvedSiteConfig } from '@config/resolved-site';
import dataService from '@lib/notion/service';
import IndexPage from '../components/IndexPage.astro';

// 获取解析后的站点配置
const SITE_CONFIG = await getResolvedSiteConfig();

// 获取所有文章数据
const allPosts = await dataService.getAllPosts();

// 分页配置
const postsPerPage = SITE_CONFIG.postsPerPage;
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const currentPage = 1; // 首页始终是第 1 页

// 只显示第一页的文章
const posts = allPosts.slice(0, postsPerPage);

// 获取 Notion Database 的标题、描述、封面和图标
const dbInfo = await dataService.getDatabaseInfo();
const pageTitle = dbInfo.title || SITE_CONFIG.title;
const pageDescription = dbInfo.description || SITE_CONFIG.description;
const pageCover = dbInfo.coverUrl || '';
const pageIcon = dbInfo.icon || '';
---

<BaseLayout>
  <IndexPage
    posts={posts}
    currentPage={currentPage}
    totalPages={totalPages}
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    pageIcon={pageIcon}
    pageCover={pageCover}
  />
</BaseLayout>
