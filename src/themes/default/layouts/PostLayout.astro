---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@lib/utils/date';
import type { PostLayoutProps } from '@lib/theme/types';
import '@theme/styles/notion.css';

const { post } = Astro.props as PostLayoutProps;
---

<BaseLayout title={post.title} description={post.summary} image={post.cover}>
  <article class="container content">
    <!-- 文章头部 -->
    <header class="post-header">
      <h1>{post.title}</h1>
      <p class="post-description">{post.summary}</p>
      <div class="post-meta">
        <time datetime={post.date}>
          发布于 {formatDate(post.date)}
        </time>
        {post.updated && (
          <span>· 更新于 {formatDate(post.updated)}</span>
        )}
        {post.readingTime && (
          <span>· {post.readingTime} 分钟阅读</span>
        )}
      </div>
      {post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map(tag => (
            <a href={`/tag/${tag.toLowerCase()}`} class="tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <!-- 文章内容 -->
    <div class="notion-content" set:html={post.content} />

    <!-- 文章底部 -->
    <footer class="post-footer">
      <div class="back-link">
        <a href="/">← 返回首页</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    text-align: center;
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-xl);
  }

  .post-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
    line-height: 1.6;
  }

  .post-meta {
    font-size: 0.938rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .tag {
    background-color: var(--color-surface);
    color: var(--color-primary);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
  }

  .tag:hover {
    background-color: var(--color-primary);
    color: white;
  }

  .notion-content {
    padding: var(--spacing-lg) 0;
  }

  .post-footer {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .back-link a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 1.875rem;
    }

    .post-description {
      font-size: 1rem;
    }
  }
</style>
