---
import { getResolvedSiteConfig } from '@config/resolved-site';
import { getMetaConfig } from '@core/config/meta';
import { generateMetaTags } from '@core/lib/meta-helpers';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  /** 本页 Markdown 版本 URL（供 AI Agent 自动发现） */
  markdownUrl?: string;
}

// 获取解析后的站点配置（合并用户配置和 Database 元数据）
const SITE_CONFIG = await getResolvedSiteConfig();

const {
  title = SITE_CONFIG.title,
  description,
  canonicalURL,
  markdownUrl,
} = Astro.props;

// 从 core 获取元信息配置
const metaConfig = getMetaConfig(SITE_CONFIG);
const canonical = canonicalURL || new URL(Astro.url.pathname, Astro.site);

// 使用 core 工具函数生成 meta 标签
const metaTags = generateMetaTags(
  metaConfig,
  title,
  canonical.pathname,
  description,
);
---

<!doctype html>
<html lang={metaConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={SITE_CONFIG.icon} />
    <link rel="canonical" href={canonical} />

    <!-- RSS Feed 自动发现 -->
    {metaConfig.enableRSS && (
      <link rel="alternate" type="application/rss+xml" title={metaConfig.title} href={metaConfig.rssUrl} />
    )}
    <!-- Markdown 版本自动发现（AI Agent） -->
    {markdownUrl && (
      <link rel="alternate" type="text/markdown" title={title} href={markdownUrl} />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{metaTags.title}</title>
    <meta name="description" content={metaTags.description} />

    <!-- Open Graph -->
    <meta property="og:type" content={metaTags.ogType} />
    <meta property="og:url" content={metaTags.ogUrl} />
    <meta property="og:title" content={metaTags.ogTitle} />
    <meta property="og:description" content={metaTags.ogDescription} />
    <meta property="og:image" content={metaTags.ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={metaTags.twitterCard} />
    {metaTags.twitterSite && <meta name="twitter:site" content={metaTags.twitterSite} />}
    <meta name="twitter:title" content={metaTags.twitterTitle} />
    <meta name="twitter:description" content={metaTags.twitterDescription} />
    <meta name="twitter:image" content={metaTags.twitterImage} />

    <!-- PhotoSwipe 样式改为在有图片的页面临近使用时注入（见 scripts/image-gallery.ts），避免全站加载 -->

    <!-- 防止主题闪烁的脚本 (必须在 head 中 inline) -->
    <script is:inline define:vars={{ darkMode: metaConfig.darkMode }}>
      if (darkMode) {
        (function() {
          const theme = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.add(theme);
        })();
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="notion-main">
      <slot />
    </main>
    <Footer />

    <!-- 语法高亮、数学公式、图表渲染和图片预览 -->
    <script>
      import '@/scripts/syntax-highlight';
      import '@/scripts/code-copy';
      import '@/scripts/math-rendering';
      import '@/scripts/mermaid-rendering';
      import '@/scripts/image-gallery';
    </script>
  </body>
</html>

<style>
  .notion-main {
    min-height: calc(100vh - 150px);
    padding-bottom: var(--spacing-3xl);
    /* 为 fixed header 预留空间（45px header 高度） */
    padding-top: 45px;
    overflow-x: hidden;
  }

  @media (max-width: 768px) {
    .notion-main {
      padding-bottom: var(--spacing-2xl);
    }
  }

  @media (max-width: 480px) {
    .notion-main {
      padding-bottom: var(--spacing-xl);
    }
  }
</style>
