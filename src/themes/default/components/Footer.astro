---
import { getResolvedSiteConfig } from '@config/resolved-site';
import { getBuildCommitSha } from '@lib/utils/version';

// 获取解析后的站点配置
const SITE_CONFIG = await getResolvedSiteConfig();

// 构建时的 commit id，非 git 环境为空（不展示）
const commitSha = getBuildCommitSha();

const REPO_URL = 'https://github.com/xxxuuu/nopress';

// 社交图标 SVG
const icons: Record<string, string> = {
  github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
  </svg>`,
  twitter: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
  </svg>`,
  rss: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
  </svg>`,
  email: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
  </svg>`,
};
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="copyright">
        <p>&copy; {SITE_CONFIG.copyrightYearText} {SITE_CONFIG.title}. All rights reserved.</p>
        <p class="powered-by">Powered by <a href={REPO_URL} target="_blank" rel="noopener noreferrer">Nopress</a>{commitSha && <span class="commit-id"> · <a href={`${REPO_URL}/commit/${commitSha}`} target="_blank" rel="noopener noreferrer">{commitSha}</a></span>}</p>
      </div>
      <div class="social-links">
        {Object.entries(SITE_CONFIG.social ?? {}).map(([platform, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label={platform}>
            <span class="icon-wrapper" set:html={icons[platform] || icons.github} />
          </a>
        ))}
        <a href="/rss/feed.xml" class="social-icon rss" aria-label="RSS订阅">
          <span class="icon-wrapper" set:html={icons.rss} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-xl) 0;
    margin-top: var(--spacing-xl);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .copyright p {
    margin: 0.25rem 0;
  }

  .powered-by {
    opacity: 0.8;
  }

  .powered-by a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
    align-items: center;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-secondary);
    transition: color var(--transition);
    text-decoration: none;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
  }

  .social-icon:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
