---
/**
 * 文章列表组件
 * @param posts - 文章数组
 */
interface Props {
  posts: typeof import('@lib/types').Post[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map(post => (
    <article class="post-card">
      <a href={`/post/${post.slug}`} class="row-link">
        <div class="row-content">
          <div class="row-main">
            <!-- 标题列 -->
            <div class="row-title">
              {post.icon ? (
                post.icon.startsWith('http')
                  ? <img src={post.icon} alt="" class="title-icon-img" />
                  : <span class="title-icon-emoji">{post.icon}</span>
              ) : (
                <span class="title-icon">📄</span>
              )}
              <h2 class="title-text">{post.title}</h2>
            </div>

            <!-- 属性列 -->
            <div class="row-properties">
              <!-- 标签 -->
              {post.tags.length > 0 && (
                <div class="property tags-property">
                  {post.tags.map(tag => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )}

              <!-- 日期 -->
              <div class="property date-property">
                <time datetime={post.publishedAt}>
                  {new Date(post.publishedAt).toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                  }).replace(/\//g, '.')}
                </time>
              </div>
            </div>

            <!-- 摘要 -->
            {post.description && (
              <p class="row-description">{post.description}</p>
            )}
          </div>

          <!-- 封面图缩略图（如果有） -->
          {post.coverUrl && (
            <div class="row-cover">
              <img src={post.coverUrl} alt={post.title} loading="lazy" />
            </div>
          )}
        </div>
      </a>
    </article>
  ))}
</div>

{posts.length === 0 && (
  <div class="empty-state">
    <p>暂无文章</p>
  </div>
)}

<style>
  /* 文章列表容器 */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* 文章卡片 */
  .post-card {
    background-color: var(--notion-bg-primary);
    transition: background-color var(--transition-fast);
    border-radius: var(--radius-sm);
  }

  .post-card:hover {
    background-color: var(--notion-bg-hover);
  }

  .row-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    text-decoration: none;
    color: inherit;
    border: none;
  }

  .row-link:hover {
    border: none;
  }

  .row-content {
    display: flex;
    gap: var(--spacing-md);
  }

  /* 封面图缩略图 - 横向长方形 */
  .row-cover {
    flex-shrink: 0;
    width: 140px;
    height: 90px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--notion-bg-secondary);
  }

  .row-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 行主体内容 */
  .row-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0; /* 防止 flex 子元素溢出 */
  }

  /* 标题行 */
  .row-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .title-icon,
  .title-icon-emoji {
    font-size: 1.125rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .title-icon-img {
    width: 1.125rem;
    height: 1.125rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .title-text {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
    color: var(--notion-text-primary);
    transition: color var(--transition-fast);
  }

  .row-link:hover .title-text {
    color: var(--notion-link);
  }

  /* 属性行 */
  .row-properties {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
  }

  .property {
    display: flex;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--notion-text-secondary);
  }

  /* 标签样式 - Notion pill */
  .tags-property {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background-color: var(--notion-bg-secondary);
    color: var(--notion-text-secondary);
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: background-color var(--transition-fast);
  }

  .post-card:hover .tag-pill {
    background-color: var(--notion-bg-hover);
  }

  /* 日期样式 */
  .date-property {
    color: var(--notion-text-tertiary);
    font-size: 0.8125rem;
  }

  /* 描述文本 */
  .row-description {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--notion-text-secondary);
    margin: 0;
    margin-left: calc(1.125rem + var(--spacing-sm)); /* 对齐图标 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 空状态 */
  .empty-state {
    padding: var(--spacing-3xl) 0;
    text-align: center;
    color: var(--notion-text-tertiary);
    font-size: 0.875rem;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    /* 移动端：增加文章项之间的间距 */
    .post-list {
      gap: 20px;
    }

    /* 移动端：文章项之间的分割线 */
    .post-card {
      border-bottom: 1px solid var(--notion-border);
      padding-bottom: 20px;
    }

    .post-card:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    /* 移动端：上下布局，配图在上方 */
    .row-content {
      flex-direction: column;
      gap: var(--spacing-xs)
    }

    .row-cover {
      width: 100%;
      height: 180px;
      order: -1; /* 将配图移到最前面 */
      margin-bottom: var(--spacing-md);
    }

    .row-link {
      padding: var(--spacing-sm) var(--spacing-xs);
    }

    .row-properties {
      margin-left: 0;
      font-size: 0.75rem;
    }

    .row-description {
      margin-left: 0;
      font-size: 0.8125rem;
    }

    .title-icon {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .row-cover {
      height: 140px; /* 小屏幕下稍微矮一点 */
    }

    .row-properties {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
    }
  }
</style>
