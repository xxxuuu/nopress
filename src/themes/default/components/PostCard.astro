---
import { formatDate } from '@lib/utils/date';
import type { PostCardProps } from '@lib/theme/types';

const {
  post,
  showCover = false,
  showExcerpt = true,
} = Astro.props as PostCardProps;
---

<article class="post-card">
  {showCover && post.cover && (
    <div class="post-cover">
      <a href={`/post/${post.slug}`}>
        <img src={post.cover} alt={post.title} />
      </a>
    </div>
  )}

  <div class="post-content">
    <h3>
      <a href={`/post/${post.slug}`}>{post.title}</a>
    </h3>

    {showExcerpt && post.summary && (
      <p class="post-description">{post.summary}</p>
    )}

    <div class="post-meta">
      <time datetime={post.date}>
        {formatDate(post.date)}
      </time>
      {post.tags.length > 0 && (
        <span class="tags">
          {post.tags.map(tag => (
            <a href={`/tag/${tag.toLowerCase()}`} class="tag">#{tag}</a>
          ))}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .post-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: all var(--transition);
  }

  .post-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .post-card:hover .post-cover img {
    transform: scale(1.05);
  }

  .post-content {
    padding: var(--spacing-lg);
  }

  .post-card h3 {
    margin-bottom: var(--spacing-sm);
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .post-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card h3 a:hover {
    color: var(--color-primary);
  }

  .post-description {
    color: var(--color-text-secondary);
    font-size: 0.938rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .tag {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .tag:hover {
    text-decoration: underline;
  }
</style>
