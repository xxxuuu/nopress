---
/**
 * 文章页：按契约 §3.1 的 getStaticPaths 模式
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import dataService from '@lib/notion/service';
import { isValidSlug } from '@lib/utils/slug';
import '../../styles/content.css';

export async function getStaticPaths() {
  const posts = await dataService.getAllPosts();
  return posts
    .filter(post => isValidSlug(post.slug))
    .map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <article>
    <header class="post-header">
      <h1>{post.title}</h1>
      <p class="post-meta">
        <time datetime={post.publishedAt}>{post.publishedAt.slice(0, 10).replace(/-/g, '.')}</time>
        {post.updatedAt && <span> | modified {post.updatedAt.slice(0, 10).replace(/-/g, '.')}</span>}
        {post.readingTime && <span> | ~{post.readingTime}min</span>}
        {post.tags.length > 0 && <span> | [{post.tags.join('/')}]</span>}
      </p>
    </header>

    {post.coverUrl && <img class="post-cover" src={post.coverUrl} alt={post.title} />}

    <div class="notion-content" set:html={post.content} />
  </article>
</BaseLayout>

<style>
  .post-header h1 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    line-height: 1.4;
    word-break: break-word;
  }

  .post-meta {
    color: var(--fg-dim);
    font-size: 0.8125rem;
    margin: 0 0 1.75rem;
  }

  .post-cover {
    width: 100%;
    border: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }
</style>
