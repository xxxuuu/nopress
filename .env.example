# ============================================
# NoPress 环境配置文件
# ============================================
# 说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填写实际配置值（不要将 .env 提交到 Git）
# 3. 环境变量会覆盖代码中的默认配置
# 4. 完整配置文档：docs/CONFIGURATION.md
# ============================================

# --------------------------------------------
# Notion API 配置（必需）
# --------------------------------------------
# 1. 访问 https://www.notion.so/my-integrations 创建 Integration
# 2. 复制 Internal Integration Token
NOTION_TOKEN=secret_your_notion_token_here

# 3. 创建或打开你的 Notion Database
# 4. 从 URL 中复制 Database ID (32位字符)
# URL 格式: https://www.notion.so/workspace/{database_id}?v=...
NOTION_DATABASE_ID=your_database_id_here

# --------------------------------------------
# 站点基本信息（可选）
# --------------------------------------------
# 说明：留空则自动使用 Notion Database 的元数据
# - SITE_TITLE: 留空使用 Database 名称
# - SITE_DESCRIPTION: 留空使用 Database 描述
# - SITE_ICON: 留空使用 Database 图标
SITE_URL=https://yourdomain.com
SITE_TITLE=
SITE_DESCRIPTION=
SITE_ICON=

# 社交链接（JSON 格式）
# 示例：{"github":"https://github.com/username","twitter":"https://twitter.com/username","email":"mailto:your@email.com"}
SITE_SOCIAL={"github":"https://github.com/yourusername","twitter":"https://twitter.com/yourusername","email":"mailto:your@email.com"}

# --------------------------------------------
# 网站设置（可选）
# --------------------------------------------
SITE_POSTS_PER_PAGE=10
SITE_ENABLE_RSS=true
SITE_ENABLE_SITEMAP=true

# --------------------------------------------
# 评论系统配置（可选）
# --------------------------------------------
# 全局开关（必须用引号包裹）
COMMENTS_ENABLED="false"

# 评论提供商
COMMENTS_PROVIDER=giscus

# Giscus 配置
# 获取方式：访问 https://giscus.app，填写仓库信息后复制配置
COMMENTS_GISCUS_REPO=owner/repo
COMMENTS_GISCUS_REPO_ID=R_kgDOG...
COMMENTS_GISCUS_CATEGORY=Announcements
COMMENTS_GISCUS_CATEGORY_ID=DIC_kwDOG...
COMMENTS_GISCUS_MAPPING=pathname
COMMENTS_GISCUS_STRICT="0"
COMMENTS_GISCUS_REACTIONS_ENABLED="1"
COMMENTS_GISCUS_EMIT_METADATA="0"
COMMENTS_GISCUS_INPUT_POSITION=bottom
COMMENTS_GISCUS_LANG=zh-CN
COMMENTS_GISCUS_LAZY="true"
